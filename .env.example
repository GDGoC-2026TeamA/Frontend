# demo (default): UI-only examples. api: real Railway signup/login and workspace.
# A fresh visit opens signup. Demo session lasts up to 8 hours in this tab.
# API mode uses POST accounts, POST sessions and Bearer tokens by default.
# Login requires login_id (not email). Signup success returns to login.
# Leave VITE_AUTH_SESSION_PATH blank for the deployed Railway API.
VITE_DATA_MODE=demo
# API tracker prefix; service calls use resource-relative paths such as 'home'.
# Public configuration only; NEVER put secrets in VITE_*.
VITE_API_BASE_URL=https://gdgoc2026a.up.railway.app/api/v1
# Optional: include the internal component preview in a production build.
VITE_ENABLE_COMPONENT_PREVIEW=false

# Optional legacy cookie adapter. Not used by the current Railway API.
# Only set these paths for a server that returns { user } and uses session cookies.
# Paths are relative to VITE_API_BASE_URL, session uses GET, profile/email use PATCH.
VITE_AUTH_LOGIN_PATH=
VITE_AUTH_SIGNUP_PATH=
VITE_AUTH_SESSION_PATH=
VITE_AUTH_PROFILE_PATH=
VITE_AUTH_EMAIL_PATH=
VITE_AUTH_LOGOUT_PATH=
VITE_AUTH_RESET_REQUEST_PATH=
VITE_AUTH_RESET_PASSWORD_PATH=
# Backend OAuth start URLs only. Never a client secret or a provider password form.
VITE_AUTH_KAKAO_START_URL=
VITE_AUTH_GOOGLE_START_URL=
