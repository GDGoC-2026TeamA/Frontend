# Example mode only. No server requests are sent by default.
VITE_DATA_MODE=demo
# API tracker prefix; service calls use resource-relative paths such as 'home'.
# Public configuration only; NEVER put secrets in VITE_*.
VITE_API_BASE_URL=/api/v1
# Optional: include the internal component preview in a production build.
VITE_ENABLE_COMPONENT_PREVIEW=false
